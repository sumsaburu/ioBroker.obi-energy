{
	"common": {
		"name": "obi-energy",
		"version": "0.1.3",
		"news": {
			"0.1.3": {
				"en": "Added flexible InfluxDB 1.x/2.x and Grafana examples",
				"de": "Flexible Beispiele für InfluxDB 1.x/2.x und Grafana ergänzt"
			},
			"0.1.2": {
				"en": "Clarified live mode behavior and power availability",
				"de": "Verhalten des Live-Modus und Verfügbarkeit der Leistung verständlicher beschrieben"
			},
			"0.1.1": {
				"en": "Improved live message parsing and privacy-safe live diagnostics",
				"de": "Verbesserte Auswertung von Live-Nachrichten und datenschutzfreundliche Live-Diagnose"
			},
			"0.1.0": {
				"en": "Initial experimental adapter with historical energy data and optional live mode",
				"de": "Erster experimenteller Adapter mit historischen Energiedaten und optionalem Live-Modus"
			}
		},
		"titleLang": {
			"en": "OBI Energy",
			"de": "OBI Energy"
		},
		"desc": {
			"en": "Connects ioBroker to the unofficial OBI and heyOBI Energy Tracker API",
			"de": "Verbindet ioBroker mit der inoffiziellen OBI- und heyOBI-Energy-Tracker-API"
		},
		"authors": ["Gerke Eckhoff <272596860+sumsaburu@users.noreply.github.com>"],
		"keywords": ["iobroker", "obi", "energy", "smart meter", "electricity"],
		"licenseInformation": {
			"type": "free",
			"license": "MIT"
		},
		"platform": "Javascript/Node.js",
		"icon": "obi-energy.png",
		"enabled": true,
		"extIcon": "https://raw.githubusercontent.com/sumsaburu/ioBroker.obi-energy/main/admin/obi-energy.png",
		"readme": "https://github.com/sumsaburu/ioBroker.obi-energy/blob/main/README.md",
		"loglevel": "info",
		"tier": 3,
		"mode": "daemon",
		"type": "energy",
		"compact": true,
		"connectionType": "cloud",
		"dataSource": "poll",
		"adminUI": {
			"config": "json"
		},
		"protectedNative": ["password"],
		"dependencies": [{ "js-controller": ">=6.0.11" }],
		"globalDependencies": [{ "admin": ">=7.0.23" }]
	},
	"native": {
		"email": "",
		"password": "",
		"pollIntervalMinutes": 5,
		"historicalDurationMinutes": 15,
		"liveEnabled": false,
		"liveUploadIntervalSeconds": 2,
		"normalUploadIntervalSeconds": 300,
		"debugApi": false
	},
